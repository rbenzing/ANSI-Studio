{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "es2024",
    "module": "nodenext",
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["server.js", "create-app.js", "public/**/*.js", "test/**/*.js"]
}
